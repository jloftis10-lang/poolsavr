---
import Layout from './Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Calculator from '../components/calculator/Calculator.astro';
import AuthorByline from '../components/AuthorByline.astro';
import Sources from '../components/Sources.astro';
import Disclaimer from '../components/Disclaimer.astro';
import type { Source } from '../components/Sources.astro';
import { breadcrumb, faqPage, webApplication } from '../lib/schema';

interface Props {
  calculatorId: string;
  title: string;
  description: string;
  h1: string;
  /** Snippet bait: 40–55 words, self-contained, directly under the H1. */
  answer: string;
  path: string;
  publishDate: Date;
  updatedDate?: Date;
  faqs: { q: string; a: string }[];
  sources?: Source[];
  /** Chemistry pages carry the "read your label" note above the article. */
  disclaimer?: 'chemistry' | 'cost';
  breadcrumbName: string;
}

const {
  calculatorId,
  title,
  description,
  h1,
  answer,
  path,
  publishDate,
  updatedDate,
  faqs,
  sources = [],
  disclaimer,
  breadcrumbName,
} = Astro.props;

const trail = [
  { name: 'Calculators', path: '/calculators/' },
  { name: breadcrumbName, path },
];
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPage(faqs))} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(webApplication({ name: h1, path, description }))}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumb(trail))}
    />
  </Fragment>

  <!-- H1 + one-sentence answer, then straight into the tool. -->
  <section class="border-b border-navy-100 bg-white pb-6 pt-6 sm:pb-8 sm:pt-8">
    <div class="container-page">
      <Breadcrumb trail={trail} class="mb-5" />
      <h1 class="max-w-3xl text-3xl sm:text-4xl">{h1}</h1>
      <p class="mt-3 max-w-3xl leading-relaxed text-navy-600 sm:mt-4 sm:text-lg">
        {answer}
      </p>
      <AuthorByline publishDate={publishDate} updatedDate={updatedDate} class="mt-5" />
    </div>
  </section>

  <!-- Calculator: above the fold, no scrolling to reach it -->
  <section class="bg-navy-50 py-6 sm:py-10">
    <div class="container-page">
      <Calculator id={calculatorId} />
      {
        disclaimer && (
          <div class="mx-auto mt-6 max-w-3xl">
            <Disclaimer kind={disclaimer} />
          </div>
        )
      }
    </div>
  </section>

  <!-- The article that makes the page rank -->
  <section class="bg-white py-16">
    <div class="container-page">
      <div class="mx-auto max-w-3xl space-y-12">
        <slot />

        <div>
          <h2 class="text-2xl">Frequently asked questions</h2>
          <div class="mt-6 space-y-4">
            {
              faqs.map((faq) => (
                <details class="group rounded-2xl border border-navy-100 bg-white px-6 py-5 open:shadow-md">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-semibold text-navy-900">
                    {faq.q}
                    <svg
                      class="h-5 w-5 shrink-0 text-blue-500 transition-transform group-open:rotate-45"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                    </svg>
                  </summary>
                  <p class="mt-4 leading-relaxed text-navy-500">{faq.a}</p>
                </details>
              ))
            }
          </div>
        </div>

        <slot name="related" />

        <Sources sources={sources} />
      </div>
    </div>
  </section>
</Layout>
