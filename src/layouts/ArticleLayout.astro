---
import Layout from './Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AuthorByline from '../components/AuthorByline.astro';
import Sources from '../components/Sources.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Calculator from '../components/calculator/Calculator.astro';
import CtaBlock from '../components/CtaBlock.astro';
import type { Source } from '../components/Sources.astro';
import { article, breadcrumb, faqPage, howTo } from '../lib/schema';
import { getAuthor } from '../data/authors';

interface Props {
  title: string;
  description: string;
  h1: string;
  /** The fix in two sentences, directly under the H1. Snippet bait. */
  fastAnswer: string;
  path: string;
  breadcrumbName: string;
  hub: { name: string; path: string };
  publishDate: Date;
  updatedDate?: Date;
  faqs: { q: string; a: string }[];
  sources?: Source[];
  /** Renders as an ordered list with HowTo schema. */
  steps?: { name: string; text: string }[];
  stepsHeading?: string;
  /** Dropped in after the steps — dosing needs gallons, capture here. */
  calculatorId?: string;
  calculatorHeading?: string;
  calculatorIntro?: string;
  /** Chemistry guides carry the "read your label" note. */
  disclaimer?: 'chemistry' | 'cost';
}

const {
  title,
  description,
  h1,
  fastAnswer,
  path,
  breadcrumbName,
  hub,
  publishDate,
  updatedDate,
  faqs,
  sources = [],
  steps = [],
  stepsHeading = 'Step by step',
  calculatorId,
  calculatorHeading = 'Every step above needs your gallons',
  calculatorIntro,
  disclaimer,
} = Astro.props;

const trail = [hub, { name: breadcrumbName, path }];
const author = getAuthor();
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPage(faqs))} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumb(trail))}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        article({
          headline: h1,
          description,
          path,
          authorName: author.name,
          authorPath: `/authors/${author.slug}/`,
          publishDate,
          updatedDate,
        }),
      )}
    />
    {
      steps.length > 0 && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(howTo({ name: h1, description: fastAnswer, steps }))}
        />
      )
    }
  </Fragment>

  <section class="border-b border-navy-100 bg-white pb-6 pt-6">
    <div class="container-page">
      <Breadcrumb trail={trail} class="mb-5" />
      <h1 class="max-w-3xl text-3xl sm:text-4xl">{h1}</h1>
      <AuthorByline publishDate={publishDate} updatedDate={updatedDate} class="mt-4" />
    </div>
  </section>

  <!-- Fast answer box: the fix in two sentences, before anything else -->
  <section class="bg-blue-50 py-6">
    <div class="container-page">
      <div class="mx-auto max-w-3xl rounded-2xl border-l-4 border-blue-500 bg-white p-6 shadow-sm">
        <p class="font-display text-sm font-bold uppercase tracking-widest text-blue-600">
          The short answer
        </p>
        <p class="mt-2 text-lg leading-relaxed text-navy-700">{fastAnswer}</p>
      </div>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="container-page">
      <div class="mx-auto max-w-3xl space-y-12">
        {
          steps.length > 0 && (
            <div>
              <h2 class="text-2xl">{stepsHeading}</h2>
              <ol class="mt-6 space-y-5">
                {steps.map((step, index) => (
                  <li class="flex gap-4">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-500 font-display text-sm font-bold text-white">
                      {index + 1}
                    </span>
                    <div class="pt-0.5">
                      <p class="font-display font-semibold text-navy-900">{step.name}</p>
                      <p class="mt-1 leading-relaxed text-navy-600">{step.text}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        {disclaimer && <Disclaimer kind={disclaimer} />}
      </div>
    </div>
  </section>

  <!-- Calculator embed: dosing needs gallons, and this is where people need it -->
  {
    calculatorId && (
      <section class="bg-navy-50 py-10">
        <div class="container-page">
          <div class="mx-auto mb-6 max-w-3xl">
            <h2 class="text-2xl">{calculatorHeading}</h2>
            {calculatorIntro && (
              <p class="mt-3 leading-relaxed text-navy-600">{calculatorIntro}</p>
            )}
          </div>
          <Calculator id={calculatorId} />
        </div>
      </section>
    )
  }

  <section class="bg-white py-12">
    <div class="container-page">
      <div class="mx-auto max-w-3xl space-y-12">
        <slot />

        <div>
          <h2 class="text-2xl">Frequently asked questions</h2>
          <div class="mt-6 space-y-4">
            {
              faqs.map((faq) => (
                <details class="group rounded-2xl border border-navy-100 bg-white px-6 py-5 open:shadow-md">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-semibold text-navy-900">
                    {faq.q}
                    <svg
                      class="h-5 w-5 shrink-0 text-blue-500 transition-transform group-open:rotate-45"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                    </svg>
                  </summary>
                  <p class="mt-4 leading-relaxed text-navy-500">{faq.a}</p>
                </details>
              ))
            }
          </div>
        </div>

        <slot name="related" />

        <Sources sources={sources} />
      </div>
    </div>
  </section>

  <CtaBlock placement="careGuide" />
</Layout>
