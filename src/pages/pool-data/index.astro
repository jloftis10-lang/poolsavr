---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { breadcrumb } from '../../lib/schema';

const trail = [{ name: 'Pool Data', path: '/pool-data/' }];
---

<Layout
  title="Pool Data: Sizes, Volumes and Measured Averages"
  description="Reference figures for pool dimensions, surface area and volume — and the measured research that will replace them once the app runs."
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumb(trail))}
    />
  </Fragment>

  <section class="border-b border-navy-100 bg-white py-10">
    <div class="container-page">
      <Breadcrumb trail={trail} class="mb-5" />
      <h1 class="max-w-3xl text-3xl sm:text-4xl">Pool data</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-navy-600">
        Reference figures today, measured research later. Once PoolSavr has
        measured real pools from satellite imagery, these pages become actual
        averages by metro, decade built and shape — rather than the rules of
        thumb everyone else republishes.
      </p>
    </div>
  </section>

  <section class="bg-navy-50 py-12">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <a
          href="/pool-data/average-pool-size"
          class="block rounded-2xl bg-white p-6 shadow-sm ring-2 ring-blue-500 transition-shadow hover:shadow-lg"
        >
          <p class="font-display text-sm font-semibold text-blue-600">
            How big is a typical pool?
          </p>
          <h2 class="mt-2 text-xl">Average pool size</h2>
          <p class="mt-2 leading-relaxed text-navy-500">
            Dimensions, water surface, interior surface and volume for the common
            residential sizes — plus why your own number matters more than the
            average.
          </p>
          <span class="mt-4 inline-block font-display text-sm font-semibold text-navy-900">
            See the figures →
          </span>
        </a>

        <div class="mt-8 rounded-2xl border border-navy-200 bg-white p-6">
          <h2 class="text-lg">What comes next</h2>
          <p class="mt-2 leading-relaxed text-navy-500">
            Measured averages by metro are waiting on the measurement app. We are
            not publishing per-metro size pages until there is real measured data
            behind them — a page that only rearranges national figures under a
            city name is not research, and search engines are right to treat it
            that way.
          </p>
          <p class="mt-3 leading-relaxed text-navy-500">
            Local cost and condition pages, which do have researched local
            substance, live under pool remodeling.
          </p>
          <a href="/pool-remodeling/" class="btn-outline mt-5">
            Pool resurfacing by metro
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBlock />
</Layout>
