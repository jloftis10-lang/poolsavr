---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { METROS } from '../../data/metros';
import { money } from '../../data/costs';
import { breadcrumb } from '../../lib/schema';

const trail = [{ name: 'Pool Remodeling', path: '/pool-remodeling/' }];
---

<Layout
  title="Pool Resurfacing by Metro: Local Costs and Conditions"
  description="What pool resurfacing costs in specific metros, plus local water hardness, season length and draining rules that change the job."
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumb(trail))}
    />
  </Fragment>

  <section class="border-b border-navy-100 bg-white py-10">
    <div class="container-page">
      <Breadcrumb trail={trail} class="mb-5" />
      <h1 class="max-w-3xl text-3xl sm:text-4xl">Pool resurfacing by metro</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-navy-600">
        Local conditions change this work more than people expect. Water hardness
        decides which finish is worth paying for, season length decides when to
        book, and draining rules differ enough between cities to matter.
      </p>
    </div>
  </section>

  <section class="bg-navy-50 py-12">
    <div class="container-page">
      <div class="grid gap-5 md:grid-cols-2">
        {
          METROS.map((metro) => (
            <a
              href={`/pool-remodeling/${metro.stateSlug}/${metro.slug}`}
              class="block rounded-2xl bg-white p-6 shadow-sm transition-shadow hover:shadow-lg"
            >
              <p class="font-display text-sm font-semibold text-blue-600">
                {metro.poolDensity} of homes have a pool
              </p>
              <h2 class="mt-2 text-xl">
                {metro.city}, {metro.stateCode}
              </h2>
              <p class="mt-1 font-display text-lg font-bold text-navy-900">
                {money(metro.resurfacingLow)}–{money(metro.resurfacingHigh)}
              </p>
              <p class="mt-2 leading-relaxed text-navy-500">
                {metro.localQuirk.title}
              </p>
              <span class="mt-4 inline-block font-display text-sm font-semibold text-navy-900">
                Local costs and conditions →
              </span>
            </a>
          ))
        }
      </div>

      <div class="mx-auto mt-10 max-w-3xl rounded-2xl border border-navy-200 bg-white p-6">
        <h2 class="text-lg">Why only a handful of metros?</h2>
        <p class="mt-2 leading-relaxed text-navy-500">
          Because a location page is only worth publishing if it says something
          genuinely local. Generating hundreds of near-identical pages is a
          doorway pattern that search engines penalise across an entire site, and
          it would drag down the calculators and guides along with it.
        </p>
        <p class="mt-3 leading-relaxed text-navy-500">
          Each metro here was researched individually — water hardness, season
          length, local draining rules, and the one thing that surprises pool
          owners there. More will follow at the same standard.
        </p>
      </div>
    </div>
  </section>

  <CtaBlock placement="costPage" />
</Layout>
