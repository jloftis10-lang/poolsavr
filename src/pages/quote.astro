---
import Layout from '../layouts/Layout.astro';
import SatelliteVisual from '../components/SatelliteVisual.astro';

const prefilledAddress = Astro.url.searchParams.get('address') ?? '';
---

<Layout
  title="Get a free pool measurement & quote — PoolSavr"
  description="Enter a property address and PoolSavr will measure the pool from satellite imagery and prepare your quote."
>
  <section class="bg-navy-900 py-16">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <span class="eyebrow bg-blue-500/15 text-blue-300">Free measurement</span>
        <h1 class="mt-6 text-4xl text-white sm:text-5xl">
          Let's measure your pool
        </h1>
        <p class="mt-4 text-lg text-navy-200">
          Enter the property address. We'll pull satellite imagery, measure the
          pool, and send your quote — usually within one business hour.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-navy-50 py-16">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <!-- Progress -->
        <ol
          id="progress"
          class="mb-10 flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-widest sm:gap-6"
        >
          {
            ['Address', 'Analysis', 'Your details'].map((label, index) => (
              <li class="flex items-center gap-3" data-progress-step={index}>
                <span
                  class="progress-dot flex h-8 w-8 items-center justify-center rounded-full bg-navy-200 text-navy-500 transition-colors"
                >
                  {index + 1}
                </span>
                <span class="progress-label hidden text-navy-400 transition-colors sm:inline">
                  {label}
                </span>
              </li>
            ))
          }
        </ol>

        <!-- Step 1: address -->
        <div id="step-address" class="rounded-3xl bg-white p-8 shadow-lg sm:p-10">
          <h2 class="text-2xl">Where is the pool?</h2>
          <p class="mt-2 text-navy-500">
            A full street address gives us the most accurate imagery match.
          </p>

          <form id="address-form" class="mt-8 space-y-5" novalidate>
            <div>
              <label
                for="address"
                class="mb-2 block text-sm font-semibold text-navy-800"
              >
                Property address
              </label>
              <input
                id="address"
                name="address"
                type="text"
                required
                autocomplete="street-address"
                value={prefilledAddress}
                placeholder="123 Palm Grove Dr, Tampa, FL 33607"
                class="input"
              />
              <p
                id="address-error"
                class="mt-2 hidden text-sm font-medium text-red-600"
              >
                Please enter the property address.
              </p>
            </div>

            <div>
              <label
                for="service"
                class="mb-2 block text-sm font-semibold text-navy-800"
              >
                What do you need quoted?
              </label>
              <select id="service" name="service" class="input">
                <option>Regular cleaning & service</option>
                <option>Resurfacing / replastering</option>
                <option>Liner replacement</option>
                <option>Pool cover</option>
                <option>Deck or hardscape work</option>
                <option>Opening / closing</option>
                <option>Something else</option>
              </select>
            </div>

            <button type="submit" class="btn-primary w-full">
              Analyze this property
            </button>
          </form>
        </div>

        <!-- Step 2: analyzing -->
        <div
          id="step-analyzing"
          class="hidden rounded-3xl bg-white p-8 shadow-lg sm:p-10"
        >
          <h2 class="text-2xl">Reading satellite imagery…</h2>
          <p id="analyzing-address" class="mt-2 text-navy-500"></p>

          <SatelliteVisual class="mt-8 shadow-md" scanning />

          <ul id="analysis-log" class="mt-8 space-y-3">
            {
              [
                'Locating parcel boundaries',
                'Fetching high-resolution imagery',
                'Detecting pool edge',
                'Calculating surface area & perimeter',
                'Matching to your service pricing',
              ].map((label, index) => (
                <li
                  class="flex items-center gap-3 text-navy-400 opacity-40 transition-all duration-300"
                  data-log-step={index}
                >
                  <span class="log-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-navy-200">
                    <svg
                      class="h-3 w-3 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  <span class="text-sm font-medium">{label}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Step 3: results + contact -->
        <div
          id="step-details"
          class="hidden rounded-3xl bg-white p-8 shadow-lg sm:p-10"
        >
          <div class="rounded-2xl border border-blue-100 bg-blue-50 p-6">
            <p class="text-xs font-bold uppercase tracking-widest text-blue-600">
              Measurement complete
            </p>
            <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
              <div>
                <p class="font-display text-2xl font-bold text-navy-900">576</p>
                <p class="text-xs text-navy-500">sq ft surface</p>
              </div>
              <div>
                <p class="font-display text-2xl font-bold text-navy-900">100</p>
                <p class="text-xs text-navy-500">ft perimeter</p>
              </div>
              <div>
                <p class="font-display text-2xl font-bold text-navy-900">32×18</p>
                <p class="text-xs text-navy-500">dimensions</p>
              </div>
              <div>
                <p class="font-display text-2xl font-bold text-blue-600">
                  <span class="blur-sm select-none">$4,820</span>
                </p>
                <p class="text-xs text-navy-500">your quote</p>
              </div>
            </div>
            <p class="mt-4 text-sm text-navy-600">
              Sample figures shown. Tell us where to send the finalized report for
              your address.
            </p>
          </div>

          <h2 class="mt-8 text-2xl">Where should we send it?</h2>

          <form id="lead-form" data-lead-form class="mt-6 space-y-5" novalidate>
            <input type="hidden" name="formType" value="pool-quote" />
            <div class="hidden" aria-hidden="true">
              <label>
                Don't fill this out
                <input name="botField" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            <input type="hidden" id="lead-address" name="address" />
            <input type="hidden" id="lead-service" name="service" />

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-sm font-semibold text-navy-800">
                  Full name
                </label>
                <input id="name" name="name" type="text" required class="input" />
              </div>
              <div>
                <label for="phone" class="mb-2 block text-sm font-semibold text-navy-800">
                  Phone
                </label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" class="input" />
              </div>
            </div>

            <div>
              <label for="email" class="mb-2 block text-sm font-semibold text-navy-800">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="input"
              />
            </div>

            <div>
              <label for="notes" class="mb-2 block text-sm font-semibold text-navy-800">
                Anything we should know? <span class="font-normal text-navy-400">(optional)</span>
              </label>
              <textarea id="notes" name="notes" rows="3" class="input"></textarea>
            </div>

            <button type="submit" class="btn-primary w-full" data-submit-button>
              Send me my quote
            </button>

            <p
              data-form-error
              class="hidden rounded-xl bg-red-50 px-4 py-3 text-center text-sm font-medium text-red-700"
            >
            </p>

            <p class="text-center text-xs text-navy-400">
              We use your address only to measure the pool. No spam, no reselling
              your information.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const addressForm = document.getElementById('address-form') as HTMLFormElement | null;
  const addressInput = document.getElementById('address') as HTMLInputElement | null;
  const serviceInput = document.getElementById('service') as HTMLSelectElement | null;
  const addressError = document.getElementById('address-error');

  const steps = {
    address: document.getElementById('step-address'),
    analyzing: document.getElementById('step-analyzing'),
    details: document.getElementById('step-details'),
  };

  const analyzingAddress = document.getElementById('analyzing-address');
  const leadAddress = document.getElementById('lead-address') as HTMLInputElement | null;
  const leadService = document.getElementById('lead-service') as HTMLInputElement | null;

  const showStep = (name: 'address' | 'analyzing' | 'details') => {
    Object.entries(steps).forEach(([key, element]) => {
      element?.classList.toggle('hidden', key !== name);
    });

    const index = { address: 0, analyzing: 1, details: 2 }[name];
    document.querySelectorAll('[data-progress-step]').forEach((item) => {
      const stepIndex = Number(item.getAttribute('data-progress-step'));
      const dot = item.querySelector('.progress-dot');
      const label = item.querySelector('.progress-label');
      const isActive = stepIndex <= index;
      dot?.classList.toggle('bg-blue-500', isActive);
      dot?.classList.toggle('text-white', isActive);
      dot?.classList.toggle('bg-navy-200', !isActive);
      dot?.classList.toggle('text-navy-500', !isActive);
      label?.classList.toggle('text-navy-900', isActive);
      label?.classList.toggle('text-navy-400', !isActive);
    });

    window.scrollTo({ top: 200, behavior: 'smooth' });
  };

  const runAnalysis = () => {
    const logSteps = document.querySelectorAll('[data-log-step]');
    logSteps.forEach((step) => {
      step.classList.add('opacity-40', 'text-navy-400');
      step.classList.remove('opacity-100', 'text-navy-800');
      const icon = step.querySelector('.log-icon');
      icon?.classList.remove('bg-blue-500', 'border-blue-500');
      icon?.classList.add('border-navy-200');
    });

    logSteps.forEach((step, index) => {
      window.setTimeout(
        () => {
          step.classList.remove('opacity-40', 'text-navy-400');
          step.classList.add('opacity-100', 'text-navy-800');
          const icon = step.querySelector('.log-icon');
          icon?.classList.add('bg-blue-500', 'border-blue-500');
          icon?.classList.remove('border-navy-200');

          if (index === logSteps.length - 1) {
            window.setTimeout(() => showStep('details'), 700);
          }
        },
        600 * (index + 1),
      );
    });
  };

  addressForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const address = addressInput?.value.trim() ?? '';

    if (!address) {
      addressError?.classList.remove('hidden');
      addressInput?.focus();
      return;
    }

    addressError?.classList.add('hidden');

    if (analyzingAddress) analyzingAddress.textContent = address;
    if (leadAddress) leadAddress.value = address;
    if (leadService) leadService.value = serviceInput?.value ?? '';

    showStep('analyzing');
    runAnalysis();
  });

  showStep('address');
</script>
