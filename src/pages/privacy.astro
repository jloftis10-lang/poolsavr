---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Privacy Policy — PoolSavr"
  description="How PoolSavr collects, uses, and protects your information."
>
  <section class="bg-white py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <h1 class="text-4xl">Privacy Policy</h1>
        <p class="mt-3 text-sm text-navy-400">
          This is placeholder copy and is not legal advice. Replace it with a
          policy reviewed by your counsel before launch.
        </p>

        <div class="mt-10 space-y-8 leading-relaxed text-navy-600">
          <div>
            <h2 class="text-xl">Information we collect</h2>
            <p class="mt-3">
              We collect the property address you submit, the contact details you
              provide (name, email, phone), and basic usage analytics about how
              the site is used.
            </p>
          </div>

          <div>
            <h2 class="text-xl">How we use it</h2>
            <p class="mt-3">
              Addresses are used to retrieve aerial imagery and produce your
              measurement report. Contact details are used to deliver that report
              and follow up about your request.
            </p>
          </div>

          <div>
            <h2 class="text-xl">What we don't do</h2>
            <p class="mt-3">
              We do not sell your personal information, and we do not resell
              submitted addresses or contact details as sales leads to third
              parties.
            </p>
          </div>

          <div>
            <h2 class="text-xl">Service providers</h2>
            <p class="mt-3">
              We share limited data with vendors that help us operate — imagery
              providers, hosting, email delivery, and analytics — under agreements
              limiting their use of it.
            </p>
          </div>

          <div>
            <h2 class="text-xl">Your choices</h2>
            <p class="mt-3">
              You can request access to, correction of, or deletion of your
              information by emailing
              <a href="mailto:hello@poolsavr.com" class="text-blue-600 hover:text-blue-700">
                hello@poolsavr.com
              </a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
