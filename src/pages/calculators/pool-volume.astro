---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Calculator from '../../components/calculator/Calculator.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import Sources from '../../components/Sources.astro';
import { breadcrumb, faqPage, webApplication } from '../../lib/schema';

const PATH = '/calculators/pool-volume/';
const publishDate = new Date('2026-08-02');
const updatedDate = new Date('2026-08-03');

// The /calculators/ hub arrives with the rest of the suite in Phase 2B; until
// then this crumb would link (and point schema) at a 404.
const trail = [{ name: 'Pool Volume Calculator', path: PATH }];

const sources = [
  {
    title: 'Volume of a cylinder, prism and other solids',
    publisher: 'NIST / U.S. Department of Commerce',
    url: 'https://www.nist.gov/pml/owm/metric-si/si-units-volume',
    accessed: 'August 2026',
  },
];

const commonSizes = [
  { size: '12 × 24 ft', depth: '3–6 ft', avg: '4.5 ft', gallons: '9,700' },
  { size: '14 × 28 ft', depth: '3–6 ft', avg: '4.5 ft', gallons: '13,200' },
  { size: '16 × 32 ft', depth: '3–6 ft', avg: '4.5 ft', gallons: '17,200' },
  { size: '18 × 36 ft', depth: '3–8 ft', avg: '5.5 ft', gallons: '26,700' },
  { size: '20 × 40 ft', depth: '3–8 ft', avg: '5.5 ft', gallons: '32,900' },
  { size: '24 ft round', depth: '4 ft', avg: '4 ft', gallons: '13,500' },
  { size: '18 ft round', depth: '4 ft', avg: '4 ft', gallons: '7,600' },
];

const mistakes = [
  {
    title: 'Measuring the deck instead of the water',
    body: 'Measure at the waterline. Including coping or deck can add several hundred gallons on a mid-size pool, which is enough to throw a shock dose off noticeably.',
  },
  {
    title: 'Using the deep-end depth as the depth',
    body: 'Volume uses average depth, not maximum. Plugging 8 feet into a pool that averages 5.5 will overstate your volume by nearly half.',
  },
  {
    title: 'Forgetting the shallow shelf',
    body: 'If your pool has a long flat shallow area before it drops off, the simple two-point average runs high. Take depth readings at three or four points and average those instead.',
  },
  {
    title: 'Treating a freeform pool as a rectangle',
    body: 'A curved pool does not fill its bounding box. Using length × width with no shape factor overstates volume by roughly 15%.',
  },
];

const faqs = [
  {
    q: 'How many gallons is my pool?',
    a: 'Most residential inground pools hold between 10,000 and 30,000 gallons. A 16 × 32 foot rectangular pool with a 3-to-6-foot depth range holds about 17,200 gallons. To get your own number, multiply length × width × average depth × 7.48.',
  },
  {
    q: 'What is the average depth of my pool?',
    a: 'Add the shallow-end depth to the deep-end depth and divide by two. A pool that is 3 feet at the steps and 8 feet at the drain averages 5.5 feet. If the shallow end has a long flat shelf before the slope starts, the real average sits slightly below that.',
  },
  {
    q: 'How accurate is this calculator?',
    a: 'For rectangular, round, and oval pools the geometry is exact, so the result is only as good as your measurements. Kidney and freeform shapes use the standard 0.85 area factor and typically land within about 5%. Steps, benches, and tanning ledges are not subtracted, so a pool with a large ledge reads slightly high.',
  },
  {
    q: 'Why does pool volume matter?',
    a: 'Nearly every pool chemical is dosed per 10,000 gallons, so an inaccurate volume means every dose is off by the same percentage. Volume also drives heater sizing, pump selection, and how long a drain-and-refill takes.',
  },
  {
    q: 'How many gallons is a 15 x 30 pool?',
    a: 'A 15 × 30 foot rectangular pool with an average depth of 4.5 feet holds about 15,100 gallons. With a deeper 3-to-8-foot profile averaging 5.5 feet, the same pool holds about 18,500 gallons.',
  },
  {
    q: 'Do I subtract steps and benches?',
    a: 'For chemical dosing, no — the difference is usually under 2%, and dosing tolerances are wider than that. For a drain-and-refill where you pay per gallon of water, subtracting a large tanning ledge is worth the effort.',
  },
];

---

<Layout
  title="Pool Volume Calculator: How Many Gallons Is My Pool?"
  description="Free pool volume calculator. Enter your dimensions to get gallons instantly — works for rectangle, oval, kidney, and round pools."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPage(faqs))} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        webApplication({ name: 'Pool Volume Calculator', path: PATH }),
      )}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumb(trail))}
    />
  </Fragment>

  <!-- H1 + one-sentence answer, then straight into the tool. -->
  <section class="border-b border-navy-100 bg-white pb-6 pt-6 sm:pb-8 sm:pt-8">
    <div class="container-page">
      <Breadcrumb trail={trail} class="mb-5" />

      <h1 class="max-w-3xl text-3xl sm:text-4xl">Pool Volume Calculator</h1>

      <p class="mt-3 max-w-3xl leading-relaxed text-navy-600 sm:mt-4 sm:text-lg">
        To find your pool's volume in gallons, multiply its surface area in
        square feet by its average depth in feet, then multiply by 7.48. A 16 ×
        32 foot pool averaging 4.5 feet deep holds about 17,200 gallons. Most
        residential inground pools fall between 10,000 and 30,000 gallons.
      </p>

      <AuthorByline
        publishDate={publishDate}
        updatedDate={updatedDate}
        class="mt-5"
      />
    </div>
  </section>

  <!-- Calculator: above the fold, no scrolling to reach it -->
  <section class="bg-navy-50 py-6 sm:py-10">
    <div class="container-page">
      <Calculator id="pool-volume" />
    </div>
  </section>

  <!-- The article that makes the page rank -->
  <section class="bg-white py-16">
    <div class="container-page">
      <div class="mx-auto max-w-3xl space-y-12">
        <div>
          <h2 class="text-2xl">How to measure your pool by hand</h2>
          <p class="mt-4 leading-relaxed text-navy-600">
            You need three numbers: length, width, and average depth. A tape
            measure and five minutes covers it.
          </p>
          <ol class="mt-5 space-y-4">
            {
              [
                'Measure length at the longest point, at the waterline rather than across the deck.',
                'Measure width at the widest point, again at the waterline.',
                'Read the shallow-end depth where the floor stops being flat — not at the very edge of the steps.',
                'Read the deep-end depth at the main drain, which is normally the deepest point.',
                'Average the two depths: add them together and divide by two.',
              ].map((step, index) => (
                <li class="flex gap-4">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-500 font-display text-sm font-bold text-white">
                    {index + 1}
                  </span>
                  <span class="pt-0.5 leading-relaxed text-navy-600">{step}</span>
                </li>
              ))
            }
          </ol>
          <p class="mt-5 leading-relaxed text-navy-600">
            For an irregular pool, measure the longest and widest points of the
            overall shape and let the calculator apply the shape factor. Do not
            try to average the curves by eye — that is where hand estimates go
            wrong.
          </p>
        </div>

        <div>
          <h2 class="text-2xl">The formulas behind the answer</h2>
          <div class="mt-5 space-y-4">
            {
              [
                {
                  shape: 'Rectangular pools',
                  formula: 'Length × Width × Average Depth × 7.48',
                  note: 'Exact geometry, no shape factor involved.',
                },
                {
                  shape: 'Round pools',
                  formula: '3.14 × (Diameter ÷ 2)² × Average Depth × 7.48',
                  note: 'Common for above-ground pools, which usually have one constant depth.',
                },
                {
                  shape: 'Oval pools',
                  formula: '3.14 × (Length ÷ 2) × (Width ÷ 2) × Average Depth × 7.48',
                  note: 'Measure both axes at their widest points.',
                },
                {
                  shape: 'Kidney and freeform pools',
                  formula: 'Length × Width × Average Depth × 7.48 × 0.85',
                  note: 'The 0.85 factor accounts for curved edges that stop the pool filling its bounding rectangle. It is an approximation — expect around 5% error.',
                },
              ].map((item) => (
                <div class="rounded-2xl border border-navy-100 bg-navy-50 p-5">
                  <h3 class="text-base">{item.shape}</h3>
                  <p class="mt-2 font-display font-semibold text-blue-600">
                    {item.formula}
                  </p>
                  <p class="mt-2 text-sm text-navy-500">{item.note}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-5 text-sm leading-relaxed text-navy-500">
            The 7.48 constant is the number of US gallons in a cubic foot
            (7.48052, to be exact). For liters, multiply gallons by 3.785.
          </p>
        </div>

        <div>
          <h2 class="text-2xl">Why your volume number matters</h2>
          <div class="mt-4 space-y-4 leading-relaxed text-navy-600">
            <p>
              <strong class="text-navy-900">Chemical dosing.</strong>{' '}
              Chlorine, stabilizer, alkalinity increaser, and algaecide are all
              dosed per 10,000 gallons. If your pool actually holds 24,000
              gallons and you have been treating it as 20,000, every dose has
              been 20% light. That is the usual reason chlorine will not hold
              through a hot week.
            </p>
            <p>
              <strong class="text-navy-900">Heater sizing.</strong>{' '}
              Heater output is matched to volume and surface area together. An
              undersized heater never reaches temperature on cool nights, and
              surface area governs how fast that heat escapes back to the air.
            </p>
            <p>
              <strong class="text-navy-900">Pump and filter selection.</strong>{' '}
              Turnover rate is the time needed to circulate the full volume once.
              Start with the wrong volume and you end up with an undersized pump
              and poor filtration.
            </p>
            <p>
              <strong class="text-navy-900">Quotes and estimates.</strong>{' '}
              Resurfacing is priced from surface area, tile and coping from
              perimeter, and a drain-and-refill from volume. Contractors ask for
              these three numbers before quoting almost any job.
            </p>
          </div>
        </div>

        <div>
          <h2 class="text-2xl">Common mistakes</h2>
          <div class="mt-5 space-y-4">
            {
              mistakes.map((mistake) => (
                <div class="rounded-2xl border border-navy-100 p-5">
                  <h3 class="text-base">{mistake.title}</h3>
                  <p class="mt-2 leading-relaxed text-navy-500">{mistake.body}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <h2 class="text-2xl">Gallons by common pool size</h2>
          <p class="mt-4 leading-relaxed text-navy-600">
            If your pool is a standard size, find it here. These use the average
            depth shown and assume no large tanning ledge.
          </p>
          <div class="mt-6 overflow-x-auto">
            <table class="w-full border-collapse text-left">
              <thead>
                <tr class="border-b-2 border-navy-200">
                  <th class="py-3 pr-4 font-display text-sm uppercase tracking-wider text-navy-500">
                    Pool size
                  </th>
                  <th class="py-3 pr-4 font-display text-sm uppercase tracking-wider text-navy-500">
                    Depth range
                  </th>
                  <th class="py-3 pr-4 font-display text-sm uppercase tracking-wider text-navy-500">
                    Average depth
                  </th>
                  <th class="py-3 font-display text-sm uppercase tracking-wider text-navy-500">
                    Volume
                  </th>
                </tr>
              </thead>
              <tbody>
                {
                  commonSizes.map((row) => (
                    <tr class="border-b border-navy-100">
                      <td class="py-3 pr-4 font-medium text-navy-900">{row.size}</td>
                      <td class="py-3 pr-4 text-navy-500">{row.depth}</td>
                      <td class="py-3 pr-4 text-navy-500">{row.avg}</td>
                      <td class="py-3 font-display font-semibold text-blue-600">
                        {row.gallons} gal
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <h2 class="text-2xl">Frequently asked questions</h2>
          <div class="mt-6 space-y-4">
            {
              faqs.map((faq) => (
                <details class="group rounded-2xl border border-navy-100 bg-white px-6 py-5 open:shadow-md">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-semibold text-navy-900">
                    {faq.q}
                    <svg
                      class="h-5 w-5 shrink-0 text-blue-500 transition-transform group-open:rotate-45"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                    </svg>
                  </summary>
                  <p class="mt-4 leading-relaxed text-navy-500">{faq.a}</p>
                </details>
              ))
            }
          </div>
        </div>

        <Sources sources={sources} />
      </div>
    </div>
  </section>
</Layout>
