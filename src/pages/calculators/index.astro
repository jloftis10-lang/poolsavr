---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { breadcrumb } from '../../lib/schema';

const trail = [{ name: 'Calculators', path: '/calculators/' }];

const live = [
  {
    slug: 'pool-volume',
    name: 'Pool volume calculator',
    answer: 'How many gallons is my pool?',
    blurb:
      'Gallons and litres from your dimensions, plus surface area and perimeter. The number every chemical dose depends on.',
    featured: true,
  },
  {
    slug: 'surface-area',
    name: 'Pool surface area calculator',
    answer: 'How many square feet is my pool?',
    blurb:
      'Square footage and perimeter — what resurfacing, tile, coping and covers are all priced from.',
  },
  {
    slug: 'chlorine-dosage',
    name: 'Chlorine dosage calculator',
    answer: 'How much chlorine do I add?',
    blurb:
      'Dose by product type — liquid, cal-hypo, dichlor or trichlor — to move from your current reading to your target.',
  },
  {
    slug: 'pool-shock',
    name: 'Pool shock calculator',
    answer: 'How much shock does my pool need?',
    blurb:
      'Breakpoint dose from your free and total chlorine readings, so the shock actually clears chloramines instead of feeding them.',
  },
];

const planned = [
  'Salt level calculator',
  'Muriatic acid calculator',
  'Baking soda / alkalinity calculator',
  'Heater sizing calculator',
  'Pump sizing calculator',
];
---

<Layout
  title="Pool Calculators: Volume, Chlorine, Shock & Surface Area"
  description="Free pool calculators for volume in gallons, surface area, chlorine dosage and shock. No signup, works on your phone, formulas shown."
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumb(trail))}
    />
  </Fragment>

  <section class="border-b border-navy-100 bg-white py-10">
    <div class="container-page">
      <Breadcrumb trail={trail} class="mb-5" />
      <h1 class="max-w-3xl text-3xl sm:text-4xl">Pool calculators</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-navy-600">
        Every one of these is free, needs no account, and shows the formula it
        applied. Start with volume — almost everything else depends on knowing
        your gallons.
      </p>
    </div>
  </section>

  <section class="bg-navy-50 py-12">
    <div class="container-page">
      <div class="grid gap-5 md:grid-cols-2">
        {
          live.map((item) => (
            <a
              href={`/calculators/${item.slug}`}
              class:list={[
                'block rounded-2xl bg-white p-6 shadow-sm transition-shadow hover:shadow-lg',
                item.featured && 'md:col-span-2 ring-2 ring-blue-500',
              ]}
            >
              <p class="font-display text-sm font-semibold text-blue-600">
                {item.answer}
              </p>
              <h2 class="mt-2 text-xl">{item.name}</h2>
              <p class="mt-2 leading-relaxed text-navy-500">{item.blurb}</p>
              <span class="mt-4 inline-block font-display text-sm font-semibold text-navy-900">
                Open the calculator →
              </span>
            </a>
          ))
        }
      </div>

      <div class="mt-10 rounded-2xl border border-navy-200 bg-white p-6">
        <h2 class="text-lg">On the way</h2>
        <p class="mt-2 text-sm text-navy-500">
          These are being built next. They all depend on your pool volume, which
          is why that calculator came first.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            planned.map((item) => (
              <li class="rounded-full bg-navy-50 px-3 py-1.5 text-sm text-navy-600">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaBlock />
</Layout>
