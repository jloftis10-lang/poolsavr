---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import CtaInline from '../../components/CtaInline.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const faqs = [
  {
    q: 'How much chlorine do I add to a 20,000 gallon pool?',
    a: 'To raise free chlorine by 1 ppm in 20,000 gallons you need about 20 fl oz of 12.5% liquid chlorine, or about 3.7 oz of 73% cal-hypo. To go from 1 ppm to 3 ppm, double those figures. Always dose against a fresh test reading rather than a guess.',
  },
  {
    q: 'How much liquid chlorine raises a pool by 1 ppm?',
    a: 'About 10 fl oz of 12.5% liquid chlorine per 10,000 gallons, or about 13 fl oz if your product is 10%. Liquid chlorine loses strength on the shelf, so a jug that has sat in a hot garage for a season will dose noticeably weaker than the label says.',
  },
  {
    q: 'What free chlorine level should I run?',
    a: 'The CDC Model Aquatic Health Code sets a minimum of 1 ppm free chlorine without cyanuric acid, or 2 ppm with it, and caps free chlorine at 10 ppm while anyone is swimming. Most residential pools sit comfortably around 2 to 4 ppm.',
  },
  {
    q: 'Why does my chlorine disappear so fast?',
    a: 'Usually one of three things: sunlight burning it off because cyanuric acid is too low, a chlorine demand from algae or organics consuming it, or an inaccurate pool volume meaning every dose has been short. Rule out the volume first — it is the cheapest to check.',
  },
  {
    q: 'Is liquid chlorine or granular better?',
    a: 'Liquid adds chlorine and nothing else, which makes it the cleanest choice for routine dosing. Cal-hypo adds calcium hardness, and dichlor and trichlor add cyanuric acid that never leaves except through dilution. If your stabiliser or calcium is already high, use liquid.',
  },
  {
    q: 'Can I swim right after adding chlorine?',
    a: 'Wait until the chlorine has circulated and your test reads within the normal range, typically 15 to 30 minutes with the pump running for liquid chlorine, and longer for granular products that need to dissolve fully.',
  },
];

const sources = [
  {
    title: '2023 Model Aquatic Health Code, 4th Edition — disinfection and water quality',
    publisher: 'Centers for Disease Control and Prevention',
    url: 'https://www.cdc.gov/model-aquatic-health-code/media/pdfs/2023-MAHC-508.pdf',
    accessed: 'August 2026',
  },
  {
    title: 'Home Pool and Hot Tub Water Treatment and Testing',
    publisher: 'Centers for Disease Control and Prevention',
    url: 'https://www.cdc.gov/healthy-swimming/about/home-pool-and-hot-tub-water-treatment-and-testing.html',
    accessed: 'August 2026',
  },
];
---

<CalculatorLayout
  calculatorId="chlorine-dosage"
  breadcrumbName="Chlorine Dosage Calculator"
  path="/calculators/chlorine-dosage/"
  title="Pool Chlorine Calculator: How Much Chlorine to Add"
  description="Work out exactly how much chlorine to add to your pool. Dosing for liquid chlorine, cal-hypo, dichlor and trichlor by volume and target ppm."
  h1="Pool Chlorine Dosage Calculator"
  answer="To raise free chlorine by 1 ppm per 10,000 gallons, add about 10 fl oz of 12.5% liquid chlorine or 1.8 oz of 73% cal-hypo. Multiply by your pool volume and by how many ppm you need to climb. The calculator below does both steps for five common products."
  publishDate={new Date('2026-08-03')}
  faqs={faqs}
  sources={sources}
  disclaimer="chemistry"
>
  <div>
    <h2 class="text-2xl">How the dose is worked out</h2>
    <p class="mt-4 leading-relaxed text-navy-600">
      All chlorine dosing comes down to one idea: you need a fixed mass of
      chlorine per gallon of water, and products differ only in how much of that
      mass they carry per ounce.
    </p>
    <p class="mt-4 leading-relaxed text-navy-600">
      Raising 10,000 gallons by 1 ppm takes 37.9 grams of available chlorine.
      Divide that by the product's strength and you have the dose.
    </p>
    <div class="mt-6 rounded-2xl border border-navy-100 bg-navy-50 p-5">
      <p class="font-display font-semibold text-blue-700">
        Gallons × ppm needed ÷ product strength = dose
      </p>
      <p class="mt-2 text-sm text-navy-500">
        Liquid strengths are trade percent — grams of available chlorine per 100
        mL — so the answer comes out as a volume. Granular strengths are percent
        by weight, so the answer comes out as a weight.
      </p>
    </div>
  </div>

  <CtaInline placement="careGuide" />

  <div>
    <h2 class="text-2xl">What each product does besides add chlorine</h2>
    <p class="mt-4 leading-relaxed text-navy-600">
      This is the part most dosing charts leave out, and it is the reason two
      pools with identical chlorine readings can behave completely differently.
    </p>
    <div class="mt-6 space-y-4">
      {
        [
          {
            name: 'Liquid chlorine (sodium hypochlorite)',
            adds: 'Nothing lasting',
            body: 'The cleanest option for routine dosing. It raises pH briefly as it goes in, then settles. Its weakness is shelf life — it degrades with heat and time, so a half-used jug from last season doses weak.',
          },
          {
            name: 'Cal-hypo (calcium hypochlorite)',
            adds: 'About 0.7 ppm calcium hardness per 1 ppm chlorine',
            body: 'Cheap and strong, but in hard-water regions the calcium accumulates and eventually shows up as scale on tile and inside the heater. Dissolve it in a bucket first rather than broadcasting it over a vinyl liner.',
          },
          {
            name: 'Dichlor',
            adds: 'About 0.9 ppm cyanuric acid per 1 ppm chlorine',
            body: 'Convenient and pH-neutral, but the stabiliser builds up quickly. Run dichlor all season and you can end up needing to drain water simply to bring cyanuric acid back down.',
          },
          {
            name: 'Trichlor tablets',
            adds: 'About 0.6 ppm cyanuric acid per 1 ppm chlorine, and it is strongly acidic',
            body: 'Built for slow, steady feeding through a floater or feeder — not for correcting a low reading today. Expect to add base regularly to counter the pH drop.',
          },
        ].map((item) => (
          <div class="rounded-2xl border border-navy-100 p-5">
            <h3 class="text-base">{item.name}</h3>
            <p class="mt-1 text-sm font-semibold text-blue-600">Adds: {item.adds}</p>
            <p class="mt-2 leading-relaxed text-navy-500">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div>
    <h2 class="text-2xl">How to dose without wasting product</h2>
    <ol class="mt-5 space-y-4">
      {
        [
          'Test first, with a kit you trust. Dosing against a guessed reading is how pools end up over-chlorinated.',
          'Confirm your volume. Every figure on this page scales directly with gallons, so an inaccurate volume makes every dose wrong by the same percentage.',
          'Add with the pump running so the dose distributes rather than settling in one spot.',
          'Pour liquid chlorine slowly around the deep end; pre-dissolve granular products in a bucket of water first.',
          'Re-test after the water has turned over once, usually a few hours, before adding anything else.',
        ].map((step, index) => (
          <li class="flex gap-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-500 font-display text-sm font-bold text-white">
              {index + 1}
            </span>
            <span class="pt-0.5 leading-relaxed text-navy-600">{step}</span>
          </li>
        ))
      }
    </ol>
    <p class="mt-5 leading-relaxed text-navy-600">
      Never mix two chlorine products together in the same bucket, and never add
      water to acid. Cal-hypo and trichlor in particular react violently with each
      other.
    </p>
  </div>

  <div>
    <h2 class="text-2xl">Common mistakes</h2>
    <div class="mt-5 space-y-4">
      {
        [
          {
            title: 'Guessing the pool volume',
            body: 'The single most common cause of chlorine that will not hold. A pool assumed to be 20,000 gallons but actually 24,000 has been receiving 20% less chlorine than intended, every single time.',
          },
          {
            title: 'Ignoring cyanuric acid',
            body: 'Stabiliser protects chlorine from sunlight, but too much of it slows chlorine down. If you have been using dichlor or trichlor all season, test it — the fix is dilution, not more chlorine.',
          },
          {
            title: 'Dosing to total chlorine instead of free',
            body: 'Total includes combined chloramines, which are spent chlorine. Dose against the free chlorine reading; if free and total differ by more than about 0.5 ppm, you need to shock rather than top up.',
          },
          {
            title: 'Trusting an old jug',
            body: 'Liquid chlorine loses several percent of its strength per month in warm storage. If a dose that used to work no longer moves the reading, suspect the product before the pool.',
          },
        ].map((item) => (
          <div class="rounded-2xl border border-navy-100 p-5">
            <h3 class="text-base">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-navy-500">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>

  <RelatedCalculators slot="related" exclude="chlorine-dosage" />
</CalculatorLayout>
