---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { breadcrumb } from '../../lib/schema';

const trail = [{ name: 'Remodeling', path: '/remodeling/' }];

const guides = [
  {
    slug: 'when-to-resurface',
    name: 'When to resurface a pool',
    answer: 'Does my pool actually need this?',
    blurb:
      'The symptoms that mean your finish is done, and the several common complaints that have far cheaper fixes.',
    featured: true,
  },
  {
    slug: 'finish-types',
    name: 'Pool finish types compared',
    answer: 'Which finish should I choose?',
    blurb:
      'Plaster, quartz, pebble and tile on cost, lifespan, texture and where each genuinely wins.',
  },
  {
    slug: 'plaster-vs-pebble',
    name: 'Plaster vs pebble',
    answer: 'Is pebble worth three times the price?',
    blurb:
      'The twenty-year arithmetic, which turns out to be closer than the sticker prices suggest.',
  },
  {
    slug: 'process-and-timeline',
    name: 'The remodel process, week by week',
    answer: 'What happens, and how long?',
    blurb:
      'Day by day from drain to refill, plus the curing period that decides how long the finish lasts.',
  },
  {
    slug: 'questions-to-ask-a-contractor',
    name: 'Questions to ask a contractor',
    answer: 'How do I compare these quotes?',
    blurb:
      'Starting with the one question that makes three wildly different bids comparable.',
  },
];
---

<Layout
  title="Pool Remodeling Guides: Resurfacing and Finishes"
  description="Decide whether your pool needs resurfacing, which finish to choose, what the process involves, and how to compare contractor quotes."
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumb(trail))}
    />
  </Fragment>

  <section class="border-b border-navy-100 bg-white py-10">
    <div class="container-page">
      <Breadcrumb trail={trail} class="mb-5" />
      <h1 class="max-w-3xl text-3xl sm:text-4xl">Pool remodeling guides</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-navy-600">
        Resurfacing is a five-figure decision, so these guides start with whether
        you need it at all. Where a cheaper fix exists, we say so.
      </p>
    </div>
  </section>

  <section class="bg-navy-50 py-12">
    <div class="container-page">
      <div class="grid gap-5 md:grid-cols-2">
        {
          guides.map((guide) => (
            <a
              href={`/remodeling/${guide.slug}`}
              class:list={[
                'block rounded-2xl bg-white p-6 shadow-sm transition-shadow hover:shadow-lg',
                guide.featured && 'md:col-span-2 ring-2 ring-blue-500',
              ]}
            >
              <p class="font-display text-sm font-semibold text-blue-600">
                {guide.answer}
              </p>
              <h2 class="mt-2 text-xl">{guide.name}</h2>
              <p class="mt-2 leading-relaxed text-navy-500">{guide.blurb}</p>
              <span class="mt-4 inline-block font-display text-sm font-semibold text-navy-900">
                Read the guide →
              </span>
            </a>
          ))
        }
      </div>

      <div class="mx-auto mt-10 max-w-3xl rounded-2xl border border-navy-200 bg-white p-6">
        <h2 class="text-lg">Costs live on their own pages</h2>
        <p class="mt-2 leading-relaxed text-navy-500">
          These guides cover the decisions. For the numbers — by pool size,
          finish and region — see the cost breakdowns.
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a href="/cost/pool-resurfacing" class="btn-outline">Resurfacing cost</a>
          <a href="/cost/pool-remodel" class="btn-outline">Full remodel cost</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBlock placement="costPage" />
</Layout>
