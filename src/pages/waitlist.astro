---
import Layout from '../layouts/Layout.astro';
import SatelliteVisual from '../components/SatelliteVisual.astro';
---

<Layout
  title="Get early access — PoolSavr satellite pool measurement"
  description="Join the waitlist for PoolSavr: pool surface area, perimeter, and volume measured from satellite imagery using only your address."
>
  <section class="bg-navy-900 py-16">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <span class="eyebrow bg-blue-500/15 text-blue-300">In development</span>
        <h1 class="mt-6 text-4xl text-white sm:text-5xl">
          Measure your pool without measuring it
        </h1>
        <p class="mt-4 text-lg text-navy-200">
          We're building a tool that reads satellite imagery and returns your
          pool's surface area, perimeter, and volume from nothing but the
          property address. It isn't live yet — leave your email and you'll be
          among the first in.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-navy-50 py-16">
    <div class="container-page">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
        <div class="rounded-3xl bg-white p-8 shadow-lg sm:p-10">
          <h2 class="text-2xl">Join the waitlist</h2>
          <p class="mt-2 text-navy-500">
            No spam, and no charge for early access.
          </p>

          <form data-lead-form class="mt-8 space-y-5" novalidate>
            <input type="hidden" name="formType" value="waitlist" />
            <div class="hidden" aria-hidden="true">
              <label>
                Don't fill this out
                <input name="botField" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div>
              <label for="email" class="mb-2 block text-sm font-semibold text-navy-800">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="input"
              />
            </div>

            <div>
              <label for="zip" class="mb-2 block text-sm font-semibold text-navy-800">
                ZIP code
                <span class="font-normal text-navy-500">(optional)</span>
              </label>
              <input
                id="zip"
                name="zip"
                type="text"
                inputmode="numeric"
                autocomplete="postal-code"
                pattern="[0-9]{5}(-[0-9]{4})?"
                placeholder="33607"
                class="input"
              />
              <p class="mt-2 text-xs text-navy-500">
                It tells us which areas to cover first.
              </p>
            </div>

            <div>
              <label for="role" class="mb-2 block text-sm font-semibold text-navy-800">
                Which describes you?
                <span class="font-normal text-navy-500">(optional)</span>
              </label>
              <select id="role" name="role" class="input">
                <option>Pool owner</option>
                <option>Pool service or cleaning company</option>
                <option>Resurfacing or remodeling contractor</option>
                <option>Deck or hardscape contractor</option>
                <option>Something else</option>
              </select>
            </div>

            <button type="submit" class="btn-primary w-full" data-submit-button>
              Get early access
            </button>

            <p
              data-form-error
              class="hidden rounded-xl bg-red-50 px-4 py-3 text-center text-sm font-medium text-red-700"
            >
            </p>

            <p class="text-center text-xs text-navy-500">
              We'll only email you about PoolSavr. Unsubscribe any time.
            </p>
          </form>
        </div>

        <div class="space-y-6">
          <SatelliteVisual class="shadow-xl ring-1 ring-navy-900/5" />

          <div class="card">
            <h2 class="text-lg">Need your numbers today?</h2>
            <p class="mt-2 text-sm leading-relaxed text-navy-500">
              The volume calculator works right now — no waitlist, no signup. If
              you can measure your pool with a tape, it will give you gallons,
              surface area, and perimeter in a few seconds.
            </p>
            <a href="/calculators/pool-volume" class="btn-outline mt-5 w-full">
              Open the calculator
            </a>
          </div>

          <div class="card">
            <h3 class="text-lg">What we're building</h3>
            <ul class="mt-4 space-y-3">
              {
                [
                  'Surface area, perimeter, and volume from an address',
                  'An annotated satellite image of the property',
                  'Measurements you can hand straight to a contractor',
                ].map((item) => (
                  <li class="flex items-start gap-3 text-sm">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-blue-500"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-navy-600">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
