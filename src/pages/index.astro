---
import Layout from '../layouts/Layout.astro';
import SatelliteVisual from '../components/SatelliteVisual.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import HeroCapture from '../components/HeroCapture.astro';
import { heroSubheadline } from '../config';

const commonSizes = [
  { size: '12 × 24 ft', depth: '3–6 ft', gallons: '~9,700' },
  { size: '14 × 28 ft', depth: '3–6 ft', gallons: '~13,200' },
  { size: '16 × 32 ft', depth: '3–6 ft', gallons: '~17,200' },
  { size: '18 × 36 ft', depth: '3–8 ft', gallons: '~26,700' },
  { size: '20 × 40 ft', depth: '3–8 ft', gallons: '~32,900' },
  { size: '24 ft round', depth: '4 ft', gallons: '~13,500' },
];

const uses = [
  {
    title: 'Dosing chemicals',
    body: 'Every label is written per 10,000 gallons. Guess low and chlorine never holds through a hot week; guess high and you waste product.',
  },
  {
    title: 'Sizing a heater or pump',
    body: 'Turnover rate is your full volume divided by pump flow. Start with the wrong volume and everything downstream is wrong too.',
  },
  {
    title: 'Getting a quote',
    body: 'Resurfacing is priced by surface area, tile and coping by perimeter, a drain-and-refill by volume. Contractors ask for these first.',
  },
];
---

<Layout
  title="How Many Gallons Is My Pool? Free Pool Size Calculator"
  description="Most pools hold 10,000–30,000 gallons. Get your exact number, plus surface area and perimeter — free, no signup, works on your phone."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-900">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(61,130,250,0.28),transparent_60%)]"
    >
    </div>
    <div class="container-page relative py-20 lg:py-24">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div>
          <h1
            class="text-4xl leading-[1.08] text-white sm:text-5xl lg:text-6xl"
          >
            How many gallons is
            <span class="text-blue-400">your pool?</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-navy-200">
            {heroSubheadline}
          </p>
          <p class="mt-4 max-w-xl leading-relaxed text-navy-300">
            Most residential inground pools hold between 10,000 and 30,000
            gallons. A standard 16 × 32 foot pool with a 3-to-6-foot depth range
            comes to roughly 17,200.
          </p>

          <HeroCapture />

          <p class="mt-4 text-sm text-navy-300">
            Or <a href="/calculators/pool-volume" class="font-semibold text-blue-300 underline underline-offset-4 hover:text-white">use the volume calculator</a> right now — free, no signup.
          </p>
        </div>

        <div class="relative">
          <SatelliteVisual class="shadow-2xl ring-1 ring-white/10" />
        </div>
      </div>
    </div>
  </section>

  <!-- Common sizes table: answers the query directly for scanners -->
  <section class="bg-white py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl">Gallons by pool size</h2>
        <p class="mt-4 leading-relaxed text-navy-600">
          If your pool is a standard size, find it here. These assume an average
          depth halfway between the shallow and deep ends, which is how volume is
          normally figured.
        </p>

        <div class="mt-8 overflow-x-auto">
          <table class="w-full min-w-md border-collapse text-left">
            <thead>
              <tr class="border-b-2 border-navy-200">
                <th class="py-3 pr-4 font-display text-sm uppercase tracking-wider text-navy-500">
                  Pool size
                </th>
                <th class="py-3 pr-4 font-display text-sm uppercase tracking-wider text-navy-500">
                  Depth
                </th>
                <th class="py-3 font-display text-sm uppercase tracking-wider text-navy-500">
                  Volume
                </th>
              </tr>
            </thead>
            <tbody>
              {
                commonSizes.map((row) => (
                  <tr class="border-b border-navy-100">
                    <td class="py-3 pr-4 font-medium text-navy-900">{row.size}</td>
                    <td class="py-3 pr-4 text-navy-500">{row.depth}</td>
                    <td class="py-3 font-display font-semibold text-blue-600">
                      {row.gallons} gal
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-6 text-sm text-navy-500">
          Your pool will not match these exactly. Steps, benches, tanning ledges,
          and a sloped floor all move the number, usually by a few hundred
          gallons either way.
        </p>

        <a href="/calculators/pool-volume" class="btn-primary mt-8">
          Calculate your exact volume
        </a>
      </div>
    </div>
  </section>

  <!-- Why it matters -->
  <section id="features" class="bg-navy-50 py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl sm:text-4xl">Three reasons the number matters</h2>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-8 md:grid-cols-3">
        {
          uses.map((use) => (
            <div class="card">
              <h3 class="text-lg">{use.title}</h3>
              <p class="mt-3 leading-relaxed text-navy-500">{use.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What's coming -->
  <section id="how-it-works" class="bg-white py-20">
    <div class="container-page">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div>
          <span class="eyebrow">In development</span>
          <h2 class="mt-6 text-3xl sm:text-4xl">
            Next: your measurements from an address alone
          </h2>
          <div class="mt-4 space-y-4 text-lg leading-relaxed text-navy-600">
            <p>
              The calculator needs you to measure the pool first. We're building
              the step that removes that: satellite imagery read automatically to
              return surface area, perimeter, and volume from just the address.
            </p>
            <p>
              It isn't finished, and we'd rather say so than pretend otherwise.
              If you want it when it lands, leave your email.
            </p>
          </div>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Cta placement="header" />
            <a href="/calculators/pool-volume" class="btn-outline">
              Use the calculator now
            </a>
          </div>
        </div>

        <SatelliteVisual class="shadow-xl ring-1 ring-navy-900/5" />
      </div>
    </div>
  </section>

  <Faq />

  <!-- Final CTA -->
  <section class="bg-blue-600 py-20">
    <div class="container-page text-center">
      <h2 class="text-3xl text-white sm:text-4xl">Get your number now</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white">
        The calculator is free and needs no account. Enter your dimensions and
        you'll have gallons, surface area, and perimeter in a few seconds.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="/calculators/pool-volume"
          class="btn bg-white px-8 text-blue-700 hover:bg-blue-50"
        >
          Open the calculator
        </a>
        <Cta placement="header" variant="onDark" />
      </div>
    </div>
  </section>
</Layout>
