---
import Layout from '../layouts/Layout.astro';
import SatelliteVisual from '../components/SatelliteVisual.astro';
import AddressForm from '../components/AddressForm.astro';
import Faq from '../components/Faq.astro';

const stats = [
  { value: '< 60 sec', label: 'Average turnaround' },
  { value: '98%', label: 'Measurement accuracy' },
  { value: '3x', label: 'More quotes sent per week' },
  { value: '$0', label: 'Cost per site visit' },
];

const steps = [
  {
    number: '01',
    title: 'Drop in an address',
    body: 'Type the property address. We pull current high-resolution satellite and aerial imagery for that parcel automatically.',
  },
  {
    number: '02',
    title: 'We measure the pool',
    body: 'Our model detects the pool edge and calculates surface area, perimeter, depth profile, and deck square footage — no tape measure required.',
  },
  {
    number: '03',
    title: 'Send a branded quote',
    body: 'Measurements flow straight into your pricing template. Review, adjust, and send a professional quote before you finish your coffee.',
  },
];

const features = [
  {
    title: 'Satellite-accurate measurements',
    body: 'Surface area, perimeter, and deck coverage computed from current imagery and verified against parcel data.',
    path: 'M3 21l18-18M9 3H3v6M15 21h6v-6',
  },
  {
    title: 'Instant quote builder',
    body: 'Map measurements to your own price book. Cleaning, resurfacing, liners, covers, chemicals — priced automatically.',
    path: 'M9 7h6M9 11h6M9 15h3M6 3h12a1 1 0 011 1v16l-3-2-2 2-2-2-2 2-2-2-3 2V4a1 1 0 011-1z',
  },
  {
    title: 'Your branding, not ours',
    body: 'Every quote goes out with your logo, colors, and terms. Customers never see PoolSavr unless you want them to.',
    path: 'M12 3a9 9 0 000 18h1.5a2 2 0 001.4-3.4 2 2 0 011.4-3.4H18a3 3 0 003-3 9 9 0 00-9-8.2zM7.5 12a1 1 0 100-2 1 1 0 000 2zm3-3.5a1 1 0 100-2 1 1 0 000 2zm5 0a1 1 0 100-2 1 1 0 000 2z',
  },
  {
    title: 'Works on any device',
    body: 'Quote from the truck, the office, or a customer’s driveway. Everything runs in the browser — nothing to install.',
    path: 'M8 3h8a1 1 0 011 1v16a1 1 0 01-1 1H8a1 1 0 01-1-1V4a1 1 0 011-1zM11 18h2',
  },
  {
    title: 'Shareable proposal links',
    body: 'Send a link customers can open, review, and accept with a signature. You get notified the moment they do.',
    path: 'M10 13a5 5 0 007.5.5l3-3a5 5 0 00-7-7l-1.8 1.7M14 11a5 5 0 00-7.5-.5l-3 3a5 5 0 007 7l1.8-1.7',
  },
  {
    title: 'Built for pool pros',
    body: 'Service routes, resurfacing, screen enclosures, and seasonal openings — the templates already match how you sell.',
    path: 'M3 16c2.2 0 2.2-2 4.5-2s2.2 2 4.5 2 2.2-2 4.5-2 2.2 2 4.5 2M3 20c2.2 0 2.2-2 4.5-2s2.2 2 4.5 2 2.2-2 4.5-2 2.2 2 4.5 2M8 14V6a2 2 0 114 0M16 14V6a2 2 0 114 0',
  },
];

const testimonials = [
  {
    quote:
      'We used to burn half a day driving out to measure pools for estimates. Now I quote from my desk and my close rate went up because I answer first.',
    name: 'Marcus Bell',
    role: 'Owner, Bell Pool & Patio',
  },
  {
    quote:
      'The measurements come back within a couple square feet of what my guys tape out. That was the thing I had to see before I trusted it.',
    name: 'Dana Whitfield',
    role: 'Operations Lead, ClearBlue Services',
  },
  {
    quote:
      'Homeowners get a real quote the same day they ask. That alone separates us from every competitor in our market.',
    name: 'Tony Alvarez',
    role: 'Founder, Sunbelt Pool Care',
  },
];

const audiences = [
  'Pool cleaning & service routes',
  'Resurfacing & remodeling',
  'Liner and cover replacement',
  'Deck & hardscape contractors',
  'Screen enclosure installers',
  'Seasonal opening & closing',
];
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-900">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(61,130,250,0.28),transparent_60%)]"
    >
    </div>
    <div class="container-page relative py-20 lg:py-28">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div>
          <span class="eyebrow bg-blue-500/15 text-blue-300">
            Pool measurement, automated
          </span>
          <h1
            class="mt-6 text-4xl leading-[1.08] text-white sm:text-5xl lg:text-6xl"
          >
            Measure any pool from space. Quote it in{' '}
            <span class="text-blue-400">under a minute.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-navy-200">
            PoolSavr reads satellite imagery to calculate surface area,
            perimeter, and deck square footage — then turns those numbers into a
            branded quote you can send before your competitor picks up the phone.
          </p>

          <div class="mt-8 max-w-lg">
            <AddressForm />
          </div>

          <p class="mt-4 text-sm text-navy-300">
            Free to try · No credit card · No site visit required
          </p>
        </div>

        <div class="relative">
          <SatelliteVisual class="shadow-2xl ring-1 ring-white/10" scanning />
          <div
            class="animate-float absolute -bottom-6 -left-6 hidden rounded-2xl bg-white p-4 shadow-xl sm:block"
          >
            <p class="text-xs font-bold uppercase tracking-widest text-navy-400">
              Estimated quote
            </p>
            <p class="mt-1 font-display text-3xl font-bold text-navy-900">
              $4,820
            </p>
            <p class="text-xs text-navy-500">Full resurface · 576 sq ft</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="border-b border-navy-100 bg-white">
    <div class="container-page grid grid-cols-2 gap-8 py-12 lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="text-center">
            <p class="font-display text-3xl font-bold text-blue-600 lg:text-4xl">
              {stat.value}
            </p>
            <p class="mt-1 text-sm text-navy-500">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="bg-white py-24">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">How it works</span>
        <h2 class="mt-6 text-3xl sm:text-4xl">
          Three steps between an address and a signed quote
        </h2>
        <p class="mt-4 text-lg text-navy-500">
          No ladders, no measuring wheels, no second trip to the property.
        </p>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          steps.map((step) => (
            <div class="card relative">
              <span class="font-display text-5xl font-bold text-blue-100">
                {step.number}
              </span>
              <h3 class="mt-4 text-xl">{step.title}</h3>
              <p class="mt-3 leading-relaxed text-navy-500">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sample report -->
  <section id="report" class="bg-navy-50 py-24">
    <div class="container-page">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div>
          <span class="eyebrow">The report</span>
          <h2 class="mt-6 text-3xl sm:text-4xl">
            Every number your estimate needs, on one page
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-navy-500">
            PoolSavr returns a complete measurement report — not just a square
            footage guess. Use it as your own worksheet or attach it to the quote
            so customers can see exactly how you priced the job.
          </p>

          <ul class="mt-8 space-y-4">
            {
              [
                'Water surface area and perimeter',
                'Deck and coping square footage',
                'Pool shape classification and dimensions',
                'Annotated satellite image of the property',
              ].map((item) => (
                <li class="flex items-start gap-3">
                  <svg
                    class="mt-0.5 h-5 w-5 shrink-0 text-blue-500"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-navy-700">{item}</span>
                </li>
              ))
            }
          </ul>

          <a href="/quote" class="btn-primary mt-8">See it on your address</a>
        </div>

        <SatelliteVisual class="shadow-xl ring-1 ring-navy-900/5" />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="bg-white py-24">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">Features</span>
        <h2 class="mt-6 text-3xl sm:text-4xl">
          Built to turn estimates into revenue
        </h2>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <div class="card">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50">
                <svg
                  class="h-5 w-5 text-blue-600"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={feature.path} />
                </svg>
              </div>
              <h3 class="mt-5 text-lg">{feature.title}</h3>
              <p class="mt-2 leading-relaxed text-navy-500">{feature.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Audiences -->
  <section class="bg-navy-900 py-20">
    <div class="container-page">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.2fr]">
        <div>
          <h2 class="text-3xl text-white sm:text-4xl">
            If you price by the square foot, PoolSavr pays for itself
          </h2>
          <p class="mt-4 text-navy-300">
            Any job that starts with "how big is the pool?" starts faster here.
          </p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {
            audiences.map((audience) => (
              <div class="flex items-center gap-3 rounded-xl bg-navy-800/60 px-4 py-3.5 ring-1 ring-white/5">
                <span class="h-2 w-2 shrink-0 rounded-full bg-blue-400" />
                <span class="text-sm text-navy-100">{audience}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white py-24">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">Customers</span>
        <h2 class="mt-6 text-3xl sm:text-4xl">Pool pros who stopped driving to measure</h2>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          testimonials.map((testimonial) => (
            <figure class="card flex flex-col">
              <div class="flex gap-1 text-blue-500">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                  </svg>
                ))}
              </div>
              <blockquote class="mt-4 grow leading-relaxed text-navy-700">
                “{testimonial.quote}”
              </blockquote>
              <figcaption class="mt-6 border-t border-navy-100 pt-4">
                <p class="font-semibold text-navy-900">{testimonial.name}</p>
                <p class="text-sm text-navy-500">{testimonial.role}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <Faq />

  <!-- Final CTA -->
  <section class="bg-blue-600 py-20">
    <div class="container-page text-center">
      <h2 class="text-3xl text-white sm:text-4xl">
        Your next quote could be done in 60 seconds
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-blue-100">
        Enter an address and see the measurements for yourself. No credit card,
        no sales call required.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="/quote"
          class="btn bg-white px-8 text-blue-700 hover:bg-blue-50"
        >
          Get a free quote
        </a>
        <a
          href="/contact"
          class="btn border-2 border-white/40 px-8 text-white hover:bg-white/10"
        >
          Book a demo
        </a>
      </div>
    </div>
  </section>
</Layout>
