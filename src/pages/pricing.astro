---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';

const plans = [
  {
    name: 'Starter',
    price: '$0',
    cadence: 'to try',
    description: 'Run a handful of measurements and see the accuracy yourself.',
    features: [
      '5 measurement reports',
      'Surface area & perimeter',
      'Annotated satellite image',
      'Email support',
    ],
    cta: 'Start free',
    href: '/quote',
    featured: false,
  },
  {
    name: 'Pro',
    price: '$149',
    cadence: 'per month',
    description: 'For active shops quoting jobs every week.',
    features: [
      '100 measurement reports / mo',
      'Your price book & branding',
      'Shareable proposal links',
      'Deck & coping measurements',
      'Priority support',
    ],
    cta: 'Get started',
    href: '/contact',
    featured: true,
  },
  {
    name: 'Fleet',
    price: 'Custom',
    cadence: 'volume pricing',
    description: 'Multi-crew operations and franchise groups.',
    features: [
      'Unlimited measurements',
      'Multiple users & territories',
      'CRM / field software integration',
      'Manual review queue',
      'Dedicated account manager',
    ],
    cta: 'Talk to sales',
    href: '/contact',
    featured: false,
  },
];
---

<Layout
  title="Pricing — PoolSavr"
  description="Simple plans for pool pros. Start free, upgrade when measurements start winning you jobs."
>
  <section class="bg-navy-900 py-16">
    <div class="container-page text-center">
      <span class="eyebrow bg-blue-500/15 text-blue-300">Pricing</span>
      <h1 class="mx-auto mt-6 max-w-2xl text-4xl text-white sm:text-5xl">
        Priced to pay for itself on the first job
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-navy-200">
        One avoided site visit covers most of a month. Start free — no card
        required.
      </p>
    </div>
  </section>

  <section class="bg-navy-50 py-20">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-3">
        {
          plans.map((plan) => (
            <div
              class:list={[
                'flex flex-col rounded-3xl bg-white p-8 shadow-sm',
                plan.featured
                  ? 'ring-2 ring-blue-500 lg:-mt-4 lg:mb-4 lg:shadow-xl'
                  : 'border border-navy-100',
              ]}
            >
              {plan.featured && (
                <span class="mb-4 self-start rounded-full bg-blue-500 px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">
                  Most popular
                </span>
              )}

              <h2 class="text-xl">{plan.name}</h2>
              <div class="mt-4 flex items-baseline gap-2">
                <span class="font-display text-4xl font-bold text-navy-900">
                  {plan.price}
                </span>
                <span class="text-sm text-navy-400">{plan.cadence}</span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-navy-500">
                {plan.description}
              </p>

              <ul class="mt-6 grow space-y-3">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3 text-sm">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-blue-500"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-navy-700">{feature}</span>
                  </li>
                ))}
              </ul>

              <a
                href={plan.href}
                class:list={[
                  'mt-8 w-full',
                  plan.featured ? 'btn-primary' : 'btn-outline',
                ]}
              >
                {plan.cta}
              </a>
            </div>
          ))
        }
      </div>

      <p class="mt-10 text-center text-sm text-navy-500">
        Measurements we can't complete don't count against your plan.
      </p>
    </div>
  </section>

  <Faq />
</Layout>
