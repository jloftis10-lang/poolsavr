---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Thanks — your PoolSavr quote is on the way"
  description="We received your request and are preparing your pool measurement report."
>
  <section class="bg-navy-50 py-24">
    <div class="container-page">
      <div
        class="mx-auto max-w-xl rounded-3xl bg-white p-10 text-center shadow-lg"
      >
        <div
          class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-blue-50"
        >
          <svg
            class="h-8 w-8 text-blue-600"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <h1 class="mt-6 text-3xl">Request received</h1>
        <p class="mt-4 leading-relaxed text-navy-500">
          We're measuring the pool now. Your report and quote will land in your
          inbox — usually within one business hour.
        </p>

        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/" class="btn-primary">Back to home</a>
          <a href="/contact" class="btn-outline">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
