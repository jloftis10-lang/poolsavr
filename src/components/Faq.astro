---
const faqs = [
  {
    q: 'How accurate are satellite measurements?',
    a: 'PoolSavr measurements typically land within 1–3% of a hand measurement. We use current high-resolution imagery and cross-check the pool outline against parcel boundaries. Every report includes the annotated image so you can eyeball the outline before you send the quote.',
  },
  {
    q: 'What if the imagery is out of date or the pool is covered?',
    a: 'We flag low-confidence properties instead of guessing. If a pool is under a cover, heavily shaded, or the imagery is stale, the report tells you so and you can request a manual review.',
  },
  {
    q: 'Do I need special software or hardware?',
    a: 'No. PoolSavr runs entirely in your browser on desktop, tablet, or phone. There is nothing to install and no drone or measuring equipment to buy.',
  },
  {
    q: 'Can I use my own pricing?',
    a: 'Yes. You load your price book once — per square foot, per linear foot, flat rates, seasonal modifiers — and every measurement is priced with your numbers automatically.',
  },
  {
    q: 'Will my customers know you measured from satellite?',
    a: 'Only if you want them to. Quotes carry your logo, colors, and terms. Many pros include the annotated satellite image because it builds trust in the number.',
  },
  {
    q: 'Which areas do you cover?',
    a: 'Anywhere with modern high-resolution aerial coverage, which includes the vast majority of residential addresses in the continental US. If we cannot measure an address, you are not charged for it.',
  },
];
---

<section id="faq" class="bg-navy-50 py-24">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">FAQ</span>
      <h2 class="mt-6 text-3xl sm:text-4xl">Questions pool pros ask first</h2>
    </div>

    <div class="mx-auto mt-12 max-w-3xl space-y-4">
      {
        faqs.map((faq) => (
          <details class="group rounded-2xl border border-navy-100 bg-white px-6 py-5 transition-shadow open:shadow-md">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-semibold text-navy-900">
              {faq.q}
              <svg
                class="h-5 w-5 shrink-0 text-blue-500 transition-transform group-open:rotate-45"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="mt-4 leading-relaxed text-navy-500">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
