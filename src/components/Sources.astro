---
/**
 * Cited references for a page's figures.
 *
 * Every chemistry constant and cost range on this site is traceable to a named
 * source. Outbound links to authoritative sources help ranking in this
 * category; they do not leak value.
 */

export interface Source {
  title: string;
  publisher: string;
  url: string;
  /** When we last checked the figure against the source. */
  accessed?: string;
}

interface Props {
  sources: Source[];
  heading?: string;
}

const { sources, heading = 'Sources' } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="mt-12 border-t border-navy-100 pt-8">
      <h2 class="text-xl">{heading}</h2>
      <ol class="mt-4 space-y-3">
        {sources.map((source) => (
          <li class="text-sm leading-relaxed text-navy-500">
            <a
              href={source.url}
              rel="nofollow noopener"
              target="_blank"
              class="font-medium text-blue-600 underline underline-offset-4 hover:text-blue-700"
            >
              {source.title}
            </a>
            <span> — {source.publisher}</span>
            {source.accessed && <span class="text-navy-400"> (accessed {source.accessed})</span>}
          </li>
        ))}
      </ol>
    </section>
  )
}
