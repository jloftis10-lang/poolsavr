---
import Logo from './Logo.astro';
import Cta from './Cta.astro';

const columns = [
  {
    title: 'Measure',
    links: [
      { href: '/calculators/pool-volume', label: 'Pool volume' },
      { href: '/calculators/surface-area', label: 'Surface area' },
      { href: '/calculators/heater-size', label: 'Heater size' },
      { href: '/calculators/pump-size', label: 'Pump size' },
    ],
  },
  {
    title: 'Chemistry',
    links: [
      { href: '/calculators/chlorine-dosage', label: 'Chlorine dosage' },
      { href: '/calculators/pool-shock', label: 'Pool shock' },
      { href: '/calculators/salt-level', label: 'Salt level' },
      { href: '/calculators/muriatic-acid', label: 'Muriatic acid' },
      { href: '/calculators/baking-soda-alkalinity', label: 'Alkalinity' },
    ],
  },
  {
    title: 'Costs',
    links: [
      { href: '/cost/pool-resurfacing', label: 'Resurfacing' },
      { href: '/cost/pool-remodel', label: 'Remodel' },
      { href: '/cost/tile-replacement', label: 'Tile' },
      { href: '/cost/coping-and-decking', label: 'Coping & decking' },
      { href: '/cost/monthly-maintenance', label: 'Monthly upkeep' },
    ],
  },
  {
    title: 'Guides',
    links: [
      { href: '/pool-care/green-pool', label: 'Green pool' },
      { href: '/pool-care/cloudy-water', label: 'Cloudy water' },
      { href: '/pool-care/losing-water', label: 'Losing water' },
      { href: '/remodeling/when-to-resurface', label: 'When to resurface' },
      { href: '/remodeling/plaster-vs-pebble', label: 'Plaster vs pebble' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/calculators/', label: 'All calculators' },
      { href: '/cost/', label: 'All costs' },
      { href: '/pool-care/', label: 'Pool care' },
      { href: '/remodeling/', label: 'Remodeling' },
      { href: '/pool-remodeling/', label: 'By metro' },
      { href: '/pool-data/average-pool-size', label: 'Average pool size' },
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-navy-800 bg-navy-900 text-navy-200">
  <div class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_3.2fr]">
      <div>
        <Logo class="text-2xl" variant="light" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-navy-300">
          Free calculators for pool volume, surface area, and perimeter. Address
          measurement from satellite imagery is in development.
        </p>
        <Cta placement="footer" class="mt-6" />
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
        {
          columns.map((column) => (
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
                {column.title}
              </h3>
              <ul class="mt-4 space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-navy-300 transition-colors hover:text-blue-400"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 border-t border-navy-800 pt-8">
      <p class="text-sm text-navy-400">
        &copy; {year} PoolSavr. All rights reserved.
      </p>
    </div>
  </div>
</footer>
