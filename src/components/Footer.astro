---
import Logo from './Logo.astro';

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/#how-it-works', label: 'How it works' },
      { href: '/#features', label: 'Features' },
      { href: '/#report', label: 'Sample report' },
      { href: '/pricing', label: 'Pricing' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
      { href: '/#faq', label: 'FAQ' },
    ],
  },
  {
    title: 'Get started',
    links: [
      { href: '/quote', label: 'Get a free quote' },
      { href: '/contact', label: 'Book a demo' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-navy-800 bg-navy-900 text-navy-200">
  <div class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_2fr]">
      <div>
        <Logo class="text-2xl" variant="light" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-navy-300">
          Pool measurements and quotes from satellite imagery — accurate to the
          square foot, delivered in under a minute.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        {
          columns.map((column) => (
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
                {column.title}
              </h3>
              <ul class="mt-4 space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-navy-300 transition-colors hover:text-blue-400"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-navy-800 pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-navy-400">
        &copy; {year} PoolSavr. All rights reserved.
      </p>
      <div class="flex gap-6 text-sm text-navy-400">
        <a href="/privacy" class="transition-colors hover:text-blue-400">Privacy</a>
        <a href="/terms" class="transition-colors hover:text-blue-400">Terms</a>
      </div>
    </div>
  </div>
</footer>
