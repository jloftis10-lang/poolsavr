---
import Logo from './Logo.astro';
import Cta from './Cta.astro';

const columns = [
  {
    title: 'Calculators',
    links: [
      { href: '/calculators/pool-volume', label: 'Pool volume calculator' },
      { href: '/calculators/surface-area', label: 'Surface area calculator' },
      { href: '/calculators/chlorine-dosage', label: 'Chlorine dosage calculator' },
      { href: '/calculators/pool-shock', label: 'Pool shock calculator' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
      { href: '/#faq', label: 'FAQ' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-navy-800 bg-navy-900 text-navy-200">
  <div class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_2fr]">
      <div>
        <Logo class="text-2xl" variant="light" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-navy-300">
          Free calculators for pool volume, surface area, and perimeter. Address
          measurement from satellite imagery is in development.
        </p>
        <Cta placement="footer" class="mt-6" />
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        {
          columns.map((column) => (
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
                {column.title}
              </h3>
              <ul class="mt-4 space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-navy-300 transition-colors hover:text-blue-400"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 border-t border-navy-800 pt-8">
      <p class="text-sm text-navy-400">
        &copy; {year} PoolSavr. All rights reserved.
      </p>
    </div>
  </div>
</footer>
