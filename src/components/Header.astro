---
import Logo from './Logo.astro';

const links = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
];
---

<header
  class="sticky top-0 z-40 border-b border-navy-100/80 bg-white/85 backdrop-blur-lg"
>
  <div class="container-page flex h-18 items-center justify-between py-4">
    <a href="/" class="flex items-center" aria-label="PoolSavr home">
      <Logo class="text-2xl" />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-navy-600 transition-colors hover:text-blue-600"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a href="/contact" class="btn-ghost">Talk to sales</a>
      <a href="/quote" class="btn-primary">Get a free quote</a>
    </div>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="inline-flex items-center justify-center rounded-lg p-2 text-navy-700 md:hidden"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-navy-100 bg-white md:hidden">
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-2.5 text-sm font-medium text-navy-700 hover:bg-navy-50"
          >
            {link.label}
          </a>
        ))
      }
      <div class="mt-3 flex flex-col gap-2">
        <a href="/contact" class="btn-outline w-full">Talk to sales</a>
        <a href="/quote" class="btn-primary w-full">Get a free quote</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
